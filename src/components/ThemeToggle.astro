<button class="theme-toggle" type="button" aria-label="Switch to dark theme" title="Change color theme">
  <svg class="sun-icon" viewBox="0 0 24 24" aria-hidden="true">
    <circle cx="12" cy="12" r="3.5"></circle>
    <path d="M12 2v2M12 20v2M4.93 4.93l1.42 1.42M17.66 17.66l1.41 1.41M2 12h2M20 12h2M4.93 19.07l1.42-1.42M17.66 6.34l1.41-1.41"></path>
  </svg>
  <svg class="moon-icon" viewBox="0 0 24 24" aria-hidden="true">
    <path d="M20.2 15.1A8.5 8.5 0 0 1 8.9 3.8 8.5 8.5 0 1 0 20.2 15.1Z"></path>
  </svg>
</button>

<script>
  const setupThemeToggle = () => {
    const toggle = document.querySelector<HTMLButtonElement>(".theme-toggle");
    if (!toggle || toggle.dataset.ready === "true") return;
    toggle.dataset.ready = "true";

    const updateLabel = () => {
      const isDark = document.documentElement.dataset.theme === "dark";
      toggle.setAttribute("aria-label", `Switch to ${isDark ? "light" : "dark"} theme`);
    };

    toggle.addEventListener("click", () => {
      const nextTheme = document.documentElement.dataset.theme === "dark" ? "light" : "dark";
      document.documentElement.dataset.theme = nextTheme;
      localStorage.setItem("theme", nextTheme);
      updateLabel();
    });

    updateLabel();
  };

  setupThemeToggle();
  document.addEventListener("astro:after-swap", setupThemeToggle);
</script>
